		</PackageReference>
		<!-- Grpc.Core (the C-core-based package, not Grpc.Net.Client) was deprecated by Google in favor
		     of grpc-dotnet years ago and has had no release since 2.46.6 - this is genuinely the latest,
		     not a stale pin. -->
		<PackageReference Include="Grpc.Core">
			<Version>2.46.6</Version>
		</PackageReference>
		<PackageReference Include="Grpc.Core.Api">
			<Version>2.83.0</Version>
		</PackageReference>
		<PackageReference Include="Grpc.Net.Client">
			<Version>2.83.0</Version>
		</PackageReference>
		<PackageReference Include="Grpc.Net.Common">
			<Version>2.83.0</Version>
		</PackageReference>
		<!-- Used by IcuBreakIteratorEncConverter (src/IcuEC), resolved dynamically by ProgID at
		     runtime just like the EcTranslators converters below - see ReadMe.md.
		     NOTE: NuGet's flat-container index lists 54.0.82/56.0.2 as later entries, but neither
		     appears in the actual nuget.org gallery version history (which still shows 3.0.2 as
		     newest) - they're unlisted/retracted releases, not a real newer version. Staying on 3.0.2
		     deliberately; don't "helpfully" bump this to one of those without checking with upstream
		     first. -->
		<PackageReference Include="icu.net">
			<Version>3.0.2</Version>
		</PackageReference>
