<?xml version="1.0"?>
<package >
	<metadata>
		<id>Encoding-Converters-Core</id>
		<version>0.9.9</version>
		<authors>Bob Eaton, Jim Kornelson, SIL International</authors>
		<owners>jnaylor, sillsdev</owners>
		<license type="expression">MIT</license>
		<projectUrl>https://github.com/silnrsi/encoding-converters-core</projectUrl>
		<requireLicenseAcceptance>false</requireLicenseAcceptance>
		<description>Libraries and merge modules for core encoding converter functionality.</description>
		<releaseNotes>Includes managed DLLs (for including in projects as nuget artifacts) in the .\lib\&lt;tfm&gt;\... folders (net462, net48, net9.0, net9.0-windows, netstandard2.0), and other managed and non-managed (read: non-nuget) resources that optionally may be manually added to projects or at least in installers in the .\runtimes\... folder -- including plugin definitions, tlb, and exe files for both Win32/x86 and x64. Some of the resources are also included in various merge modules in the .\installer\MergeModules... folder</releaseNotes>
		<copyright>Copyright 2017-2026</copyright>
		<tags></tags>
		<dependencies>
			<group targetFramework=".NETFramework4.6.2" />
			<group targetFramework=".NETFramework4.8" />
			<group targetFramework=".NETStandard2.0" />
			<group targetFramework="net9.0" />
			<!--Deliberately no net9.0-windows group: NuGet's NU1012 validation requires an OS-versioned
				moniker (e.g. net9.0-windows7.0) for a platform-specific TFM used here, but NU5128's own
				check does a literal string comparison against the lib/ folder name ("net9.0-windows"),
				so a versioned variant doesn't satisfy it either - it just adds a SECOND complaint ("add
				lib assets for net9.0-windows7.0") instead of resolving the first. Tested empirically:
				bare "net9.0-windows7.0" -> 2 warning lines; omitted entirely -> 1 warning line. Since
				every group here is an empty placeholder anyway (no actual <dependency> children - this
				section carries zero functional weight, verified: removing it entirely still packs fine
				and still resolves correctly for consumers, NuGet's lib/ asset selection doesn't consult
				this section), this is genuinely cosmetic - accept the one-line NU5128 warning rather than
				chase an unwinnable two-validation contradiction.-->
		</dependencies>
		<readme>ReadMe.md</readme>
	</metadata>
	<files>
		<file src=".\ReadMe.md" />

		<!--net462 and net48: ECInterfaces (SilEncConverters40's contract) + SilEncConverters40 (the
			dispatcher) both genuinely target these TFMs, so both DLLs come straight from that TFM's own
			build - x86 first (AnyCPU, works everywhere) then x64 (not AnyCPU)-->
		<file src=".\output\net462\Win32\Release\ECInterfaces.dll" target="lib\net462\x86"/>
		<file src=".\output\net462\Win32\Release\SilEncConverters40.dll" target="lib\net462\x86"/>
		<file src=".\output\net462\x64\Release\ECInterfaces.dll" target="lib\net462\x64"/>
		<file src=".\output\net462\x64\Release\SilEncConverters40.dll" target="lib\net462\x64"/>

		<file src=".\output\net48\Win32\Release\ECInterfaces.dll" target="lib\net48\x86"/>
		<file src=".\output\net48\Win32\Release\SilEncConverters40.dll" target="lib\net48\x86"/>
		<file src=".\output\net48\x64\Release\ECInterfaces.dll" target="lib\net48\x64"/>
		<file src=".\output\net48\x64\Release\SilEncConverters40.dll" target="lib\net48\x64"/>

		<!--net9.0-windows: only SilEncConverters40 targets this exact TFM (it needs WinForms);
			ECInterfaces has no WinForms dependency so it only has a bare net9.0 build - borrow that one
			into the net9.0-windows lib folder too, so a net9.0-windows consumer still gets both DLLs
			(NuGet picks one lib\<tfm>\ folder per consuming project, not a mix across folders, so
			ECInterfaces has to physically be here, not just discoverable via its own net9.0 folder)-->
		<file src=".\output\net9.0\Win32\Release\ECInterfaces.dll" target="lib\net9.0-windows\x86"/>
		<file src=".\output\net9.0-windows\Win32\Release\SilEncConverters40.dll" target="lib\net9.0-windows\x86"/>
		<file src=".\output\net9.0\x64\Release\ECInterfaces.dll" target="lib\net9.0-windows\x64"/>
		<file src=".\output\net9.0-windows\x64\Release\SilEncConverters40.dll" target="lib\net9.0-windows\x64"/>

		<!--netstandard2.0 and bare net9.0: ECInterfaces only (no SilEncConverters40 companion exists for
			either) - useful for a consumer that just wants the IEncConverter contract types (e.g. to
			implement a custom converter) without the full dispatcher. Genuinely platform-agnostic pure
			IL, so no x86/x64 split needed - but source from the x86-Platform build specifically
			(PlatformTarget=AnyCPU there vs PlatformTarget=x64 for the x64-Platform build, even though
			the TargetFramework is the same either way), since that's the one that's actually portable.-->
		<file src=".\output\netstandard2.0\Win32\Release\ECInterfaces.dll" target="lib\netstandard2.0"/>
		<file src=".\output\net9.0\Win32\Release\ECInterfaces.dll" target="lib\net9.0"/>

		<!--this props file is needed so that when you consume this nuget package, the build will look in the right place for the x86 vs x64
			depending on the build configured (this only appears to work for msbuild, which I don't use...) - only needed for net462/net48/net9.0-windows,
			since those are the only TFMs using the non-standard lib\<tfm>\<platform>\ nesting (netstandard2.0/net9.0 use the standard, unnested lib\<tfm>\ layout,
			which NuGet already auto-references without help)-->
		<file src=".\build\Encoding-Converters-Core.props" target="build" />

		<!--these are extra bits that any given application might want to use, but aren't specifically referenced by an EncConverters (managed) client
			for x86 and then for x64. For the managed ones, if you do want to include one of them specifically (most frequently, AIGuesserEc or CcEc),
			you can add something like this to the csproj file (net48 client shown; a net9.0-windows client uses
			$(EcDistFilesPath)\net9.0-windows\win-x86\native\... instead - see the net9.0-windows <file> entries below for why net48
			and net9.0-windows can't share a folder here):

				<Reference Include="AIGuesserEC">
					<HintPath>$(EcDistFilesPath)\win-x86\native\AIGuesserEC.dll</HintPath>
				</Reference>

			NB: by not putting them in runtimes\win-x86\native, which would be more standard, it leaves them just in the
				project folder, so it won't copy them to each project. But they want to be copied to the output folder,
				so add (to a main project) a Pre-build event like this:

				xcopy /y "$(EcDistFilesPath)\win-$(PlatformName)\native\*.*" "$(SolutionDir)output\net48\$(PlatformName)\$(ConfigurationName)\"
				xcopy /s /y "$(EcDistFilesPath)\redist\*.*" "$(SolutionDir)output\net48\$(PlatformName)\$(ConfigurationName)\"

				(a net9.0-windows client would instead copy from $(EcDistFilesPath)\net9.0-windows\win-$(PlatformName)\native\
				into its own output\net9.0-windows\... tree)
			-->

		<file src=".\output\net48\Win32\Release\*.dll" target="runtimes\EcDistFiles\win-x86\native" />
		<file src=".\output\net48\Win32\Release\*.config" target="runtimes\EcDistFiles\win-x86\native" />
		<file src=".\output\net48\Win32\Release\*.tlb" target="runtimes\EcDistFiles\win-x86\native" />
		<file src=".\output\net48\Win32\Release\*.exe" target="runtimes\EcDistFiles\win-x86\native" />
		<file src=".\output\net48\x64\Release\*.dll" target="runtimes\EcDistFiles\win-x64\native" />
		<file src=".\output\net48\x64\Release\*.config" target="runtimes\EcDistFiles\win-x64\native" />
		<file src=".\output\net48\x64\Release\*.tlb" target="runtimes\EcDistFiles\win-x64\native" />
		<file src=".\output\net48\x64\Release\*.exe" target="runtimes\EcDistFiles\win-x64\native" />

		<!--Same idea, for a net9.0-windows-consuming client instead of net48 - kept in a separate
			net9.0-windows\ subfolder (not merged into win-x86\/win-x64\ above) since a net48 host and
			a net9.0-windows host can't use the same build at all (see Handover.md's "Net9-windows
			merge modules" note - unlike net462, which shares net48's CLR family, .NET Framework and
			.NET Core/.NET 9 are separate, non-interoperable runtimes). Also needs *.json
			(.deps.json/.runtimeconfig.json) alongside the usual *.dll/*.config/*.tlb/*.exe - a .NET
			Core exe won't even launch without its .runtimeconfig.json sitting next to it, unlike a
			.NET Framework one. Scope note: like the net48 bundle above, this only picks up the flat,
			top-level output folder - it does NOT recurse into satellite-resource culture subfolders
			(de\, es\, fr\, etc.) or the runtimes\ RID-specific native-asset subfolder that a full
			net9.0-windows build also produces, matching the net48 bundle's existing "flat files only"
			fidelity rather than a true xcopy-deployment closure.-->
		<file src=".\output\net9.0-windows\Win32\Release\*.dll" target="runtimes\EcDistFiles\net9.0-windows\win-x86\native" />
		<file src=".\output\net9.0-windows\Win32\Release\*.config" target="runtimes\EcDistFiles\net9.0-windows\win-x86\native" />
		<file src=".\output\net9.0-windows\Win32\Release\*.tlb" target="runtimes\EcDistFiles\net9.0-windows\win-x86\native" />
		<file src=".\output\net9.0-windows\Win32\Release\*.exe" target="runtimes\EcDistFiles\net9.0-windows\win-x86\native" />
		<file src=".\output\net9.0-windows\Win32\Release\*.json" target="runtimes\EcDistFiles\net9.0-windows\win-x86\native" />
		<file src=".\output\net9.0-windows\x64\Release\*.dll" target="runtimes\EcDistFiles\net9.0-windows\win-x64\native" />
		<file src=".\output\net9.0-windows\x64\Release\*.config" target="runtimes\EcDistFiles\net9.0-windows\win-x64\native" />
		<file src=".\output\net9.0-windows\x64\Release\*.tlb" target="runtimes\EcDistFiles\net9.0-windows\win-x64\native" />
		<file src=".\output\net9.0-windows\x64\Release\*.exe" target="runtimes\EcDistFiles\net9.0-windows\win-x64\native" />
		<file src=".\output\net9.0-windows\x64\Release\*.json" target="runtimes\EcDistFiles\net9.0-windows\win-x64\native" />

		<!--these are bits for including in an installer (merge modules, plug-ins, and help files. But these don't need
			to be in each project and make it take forever. Just put them in runtimes so they don't get copied-->
		<file src=".\output\MergeModules\**\*.*" target="runtimes\EcDistFiles\MergeModules" exclude="**\*.wixpdb"/>
		<file src=".\redist\EC\Plugins\*.xml" target="runtimes\EcDistFiles\redist\EC\Plugins" />
		<file src=".\redist\Help\**\*.*" target="runtimes\EcDistFiles\redist\Help" />
	</files>
</package>