<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <!-- $(SolutionDir) is only meaningfully set by MSBuild when building via the .sln (see ECInterfaces
       2010.csproj for the full rationale) -->
  <PropertyGroup Condition="'$(SolutionDir)'=='' or '$(SolutionDir)'=='*Undefined*' or '$(SolutionDir)'=='$(MSBuildProjectDirectory)\'">
    <SolutionDir>$(MSBuildThisFileDirectory)..\..\</SolutionDir>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFrameworks>net462;net48;net9.0-windows</TargetFrameworks>
    <!-- required for VS's Configuration Manager to accept the .sln's x86/x64 entries for this
         multi-targeted project - see ECInterfaces 2010.csproj for why -->
    <Platforms>x86;x64</Platforms>
    <ProjectGuid>{3E4B908A-4F96-43C5-981B-1AA4B73CCC26}</ProjectGuid>
    <AssemblyName>SilEncConverters40</AssemblyName>
    <AssemblyOriginatorKeyFile>..\FieldWorks.snk</AssemblyOriginatorKeyFile>
    <SignAssembly>true</SignAssembly>
    <OutputType>Library</OutputType>
    <RootNamespace>SilEncConverters40</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- see ECInterfaces 2010.csproj: AppendTargetFrameworkToOutputPath=false also unsuffixes obj\,
         which collides across TFMs building in parallel - obj\ has no external consumers, so just
         suffix it unconditionally. -->
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\$(TargetFramework)\</IntermediateOutputPath>
    <!-- this folder also contains dead, uncompiled leftover files (AutoConfigDialogWin.*) that the
         original explicit-only item list never included; disable default globbing so they (and
         anything else not explicitly listed below) stay excluded exactly as before -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <BaseAddress>285212672</BaseAddress>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
  </PropertyGroup>

  <!-- Replaces RegisterForComInterop, which failed the ENTIRE build without admin rights (confirmed:
       the original pre-SDK-style project had this exact same limitation - not a regression from the
       SDK-style conversion). Its RegisterAssembly task does type-library export AND registry
       registration as one atomic, admin-only operation, so a non-elevated build never produced a .tlb
       at all - but the WiX merge modules (EC_40_MM/_64bit) need SilEncConverters40.tlb for Release
       packaging, and that doesn't actually require the registry write. Split into two explicit steps
       instead (see ECInterfaces 2010.csproj for the same pattern): -->
  <Target Name="ExportAndRegisterTypeLibrary" AfterTargets="Build" Condition="'$(TargetFramework)'=='net462' or '$(TargetFramework)'=='net48'">
    <PropertyGroup>
      <!-- $(TargetFrameworkSDKToolsDirectory) is only populated by the full MSBuild toolset (VS/MSBuild.exe);
           `dotnet build` never sets it, which made TlbExp resolve to an empty path and fail with MSB3073.
           Fall back to the well-known Windows SDK NETFX Tools folder so this works under both hosts. -->
      <_NetFxToolsDir Condition="'$(TargetFrameworkSDKToolsDirectory)' != ''">$(TargetFrameworkSDKToolsDirectory)</_NetFxToolsDir>
      <_NetFxToolsDir Condition="'$(TargetFrameworkSDKToolsDirectory)' == ''">$(MSBuildProgramFiles32)\Microsoft SDKs\Windows\v10.0A\bin\NETFX 4.8 Tools\</_NetFxToolsDir>
      <_TlbExpToolPath Condition="'$(Platform)'=='x64'">$(_NetFxToolsDir)x64\TlbExp.exe</_TlbExpToolPath>
      <_TlbExpToolPath Condition="'$(Platform)'!='x64'">$(_NetFxToolsDir)TlbExp.exe</_TlbExpToolPath>
      <_RegAsmToolPath Condition="'$(Platform)'=='x64'">$(SystemRoot)\Microsoft.NET\Framework64\v4.0.30319\RegAsm.exe</_RegAsmToolPath>
      <_RegAsmToolPath Condition="'$(Platform)'!='x64'">$(SystemRoot)\Microsoft.NET\Framework\v4.0.30319\RegAsm.exe</_RegAsmToolPath>
    </PropertyGroup>
    <!-- required: TlbExp only exports, no registry access, so this always succeeds regardless of
         elevation -->
    <Exec Command="&quot;$(_TlbExpToolPath)&quot; &quot;$(TargetPath)&quot; /out:&quot;$(TargetDir)$(TargetName).tlb&quot;" />
    <!-- optional, local-dev-only: registers this build in HKCR so e.g. a Word VBA macro can
         CreateObject() against it without running the installer. Needs admin; failure here is
         expected and harmless when not elevated (production registration is the WiX merge modules'
         job either way), so it's best-effort (warns, doesn't fail the build) and Debug-only,
         matching this project's prior RegisterForComInterop scoping. -->
    <Exec Command="&quot;$(_RegAsmToolPath)&quot; &quot;$(TargetPath)&quot; /codebase /tlb:&quot;$(TargetDir)$(TargetName).tlb&quot;"
          ContinueOnError="WarnAndContinue"
          Condition="'$(Configuration)'=='Debug'" />
  </Target>

  <!-- Runtime plugin-discovery data (EC\Plugins, Help, MapsTables, redist DLLs) - was on ECInterfaces
       2010.csproj as a PreBuildEvent, but EncConverters.GetRunningFolder (in EncConverters.cs) resolves
       via Assembly.GetExecutingAssembly().CodeBase, i.e. wherever SilEncConverters40.dll (this
       project's own output) physically sits - not ECInterfaces.dll. They shared an output folder for
       net462/net48 (identical TFM string for both projects), which is why keeping it on ECInterfaces
       appeared to work, but ECInterfaces has no net9.0-windows TFM (only bare net9.0), so for that TFM
       the two projects' outputs land in different folders and the data never reached this one. Moved
       here, AfterTargets="Build" (not PreBuildEvent - see ECInterfaces 2010.csproj for why $(TargetDir)
       isn't reliably resolved yet at PreBuildEvent time for a multi-targeted build). -->
  <Target Name="CopyRedistFiles" AfterTargets="Build" Condition="'$(OS)'=='Windows_NT' and '$(TargetFramework)'!=''">
    <!-- the TargetFramework!='' half of the condition matters: this project cross-targets, so the SDK
         also invokes the "Build" target once at the outer, TFM-unspecified level (which just dispatches
         to the inner per-TFM builds) - $(TargetDir) is genuinely undefined there (confirmed via
         MSB3073 with an empty-string TargetDir), so without this guard the outer pass runs this target
         too and fails. ExportAndRegisterTypeLibrary above is naturally immune since its own TFM
         equality check already evaluates false when $(TargetFramework) is empty. -->
    <Exec Command="xcopy /s /y &quot;$(SolutionDir)redist\EC&quot; &quot;$(TargetDir)EC\&quot;
xcopy /s /y &quot;$(SolutionDir)redist\Help&quot; &quot;$(TargetDir)Help\&quot;
xcopy /s /y &quot;$(SolutionDir)redist\MapsTables&quot; &quot;$(TargetDir)MapsTables\&quot;
xcopy /y &quot;$(SolutionDir)redist&quot; &quot;$(TargetDir)&quot;
if $(Platform) == x64 (
xcopy /y &quot;$(SolutionDir)redist/64bit&quot; &quot;$(TargetDir)&quot;
) ELSE (
xcopy /y &quot;$(SolutionDir)redist/32bit&quot; &quot;$(TargetDir)&quot;
)" />
  </Target>

  <PropertyGroup Condition="'$(TargetFramework)'=='net9.0-windows'">
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WFO1000: modern WinForms designer-serialization analyzer, new to net9.0-windows and not
         applicable to the .NET Framework TFMs this code was written for; no source changes in this
         pass (see Handover.md), so suppress rather than retrofit [DesignerSerializationVisibility]
         attributes across the codebase -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <!-- every TFM gets its own sibling folder under output\ (including net48, via $(TargetFramework)) -
       the WiX merge modules now read net48's output from output\net48\... - see ECInterfaces
       2010.csproj for the full rationale. -->
  <PropertyGroup Condition="'$(Platform)'=='x86'">
    <OutputPath>$(SolutionDir)output\$(TargetFramework)\Win32\$(Configuration)\</OutputPath>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='x64'">
    <OutputPath>$(SolutionDir)output\$(TargetFramework)\$(Platform)\$(Configuration)\</OutputPath>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

