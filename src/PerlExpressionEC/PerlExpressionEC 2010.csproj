<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <!-- $(SolutionDir) is only meaningfully set by MSBuild when building via the .sln (see ECInterfaces
       2010.csproj for the full rationale) -->
  <PropertyGroup Condition="'$(SolutionDir)'=='' or '$(SolutionDir)'=='*Undefined*' or '$(SolutionDir)'=='$(MSBuildProjectDirectory)\'">
    <SolutionDir>$(MSBuildThisFileDirectory)..\..\</SolutionDir>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFrameworks>net462;net48;net9.0-windows</TargetFrameworks>
    <!-- required for VS's Configuration Manager to accept the .sln's x86/x64 entries for this
         multi-targeted project - see ECInterfaces 2010.csproj for why -->
    <Platforms>x86;x64</Platforms>
    <ProjectGuid>{4704F67B-246D-483C-B840-231F42D7A12B}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>PerlExpressionEC</RootNamespace>
    <AssemblyName>PerlExpressionEC</AssemblyName>
    <!-- restores this project's pre-SDK-conversion signing (matches ECInterfaces/EncCnvtrs/AIGuesserEC/
         CcEC/SilIndicEncConverters, all signed with the same key): a .NET Framework assembly that is
         itself strongly named (TestEncCnvtrs, signed this session for InternalsVisibleTo) cannot
         reference a weakly-named one - doing so throws FileLoadException ("A strongly-named assembly is
         required") at load time under net462/net48 (confirmed - this was reported after that change). -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\FieldWorks.snk</AssemblyOriginatorKeyFile>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- see ECInterfaces 2010.csproj: AppendTargetFrameworkToOutputPath=false also unsuffixes obj\,
         which collides across TFMs building in parallel - obj\ has no external consumers, so just
         suffix it unconditionally. -->
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\$(TargetFramework)\</IntermediateOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)'=='net9.0-windows'">
    <UseWindowsForms>true</UseWindowsForms>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <!-- every TFM gets its own sibling folder under output\ (including net48, via $(TargetFramework))
       - see ECInterfaces 2010.csproj for why -->
  <PropertyGroup Condition="'$(Platform)'=='x86'">
    <OutputPath>$(SolutionDir)output\$(TargetFramework)\Win32\$(Configuration)\</OutputPath>
    <!-- must be x86, not AnyCPU: this codebase's native transducer DLLs (e.g. TECkit_x86.dll,
         CC32.dll) only load if the process itself is forced 32-bit - see CLAUDE.md's "Strict
         Bit-Width Separation" constraint - AnyCPU here let the process run as 64-bit on a 64-bit
         OS, breaking every x86 native-interop test. -->
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='x64'">
    <OutputPath>$(SolutionDir)output\$(TargetFramework)\$(Platform)\$(Configuration)\</OutputPath>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)'=='net462' or '$(TargetFramework)'=='net48'">
    <Reference Include="System" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <!-- PerlExpressionAutoConfigDialog.cs is declared "namespace SilEncConverters40", not this project's
       RootNamespace ("PerlExpressionEC") - without this DependentUpon, the SDK's default-item globbing
       names the embedded resx after RootNamespace instead (PerlExpressionEC.PerlExpressionAutoConfigDialog),
       which wouldn't match a real lookup like `new ComponentResourceManager(typeof(PerlExpressionAutoConfigDialog))`. -->
  <ItemGroup>
    <EmbeddedResource Update="PerlExpressionAutoConfigDialog.resx">
      <DependentUpon>PerlExpressionAutoConfigDialog.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ECInterfaces\ECInterfaces 2010.csproj" />
    <ProjectReference Include="..\EncCnvtrs\EncCnvtrs 2010.csproj" />
  </ItemGroup>
</Project>
