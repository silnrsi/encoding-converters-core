<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <!-- $(SolutionDir) is only meaningfully set by MSBuild when building via the .sln (see ECInterfaces
       2010.csproj for the full rationale) -->
  <PropertyGroup Condition="'$(SolutionDir)'=='' or '$(SolutionDir)'=='*Undefined*' or '$(SolutionDir)'=='$(MSBuildProjectDirectory)\'">
    <SolutionDir>$(MSBuildThisFileDirectory)..\..\</SolutionDir>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFrameworks>net462;net48;net9.0-windows</TargetFrameworks>
    <!-- required for VS's Configuration Manager to accept the .sln's x86/x64 entries for this
         multi-targeted project - see ECInterfaces 2010.csproj for why -->
    <Platforms>x86;x64</Platforms>
    <ProjectGuid>{E13305E0-0AC9-4181-A9AD-3B9B0A479087}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>TestEncCnvtrs</RootNamespace>
    <AssemblyName>TestEncCnvtrs</AssemblyName>
    <!-- signed with the same key pair as EncCnvtrs/SilEncConverters40 solely so that assembly's
         InternalsVisibleTo (see its AssemblyInfo.cs; needed to unit-test the subprocess fallback's
         internal NativeModuleConflictDetector/PersistentEncConverterHostSession/SubprocessEncConverter
         types) can name this assembly's public key; not otherwise required for a test project. -->
    <AssemblyOriginatorKeyFile>..\FieldWorks.snk</AssemblyOriginatorKeyFile>
    <SignAssembly>true</SignAssembly>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- AutoGenerateBindingRedirects alone has no effect on a Library-output project (MSBuild only
         auto-writes the computed redirects into <AssemblyName>.dll.config for Exe/Web output by
         default) - GenerateBindingRedirectsOutputType forces it here too. Needed because several
         Google.Cloud.* packages (via EcTranslators, referenced transitively here) ship prebuilt DLLs
         compiled against older Google.Apis.Auth/Google.Apis versions than the ones SharedItems.props
         pins and actually deploys (e.g. Google.Cloud.Translation.V2 3.5.0 references
         Google.Apis.Auth 1.72.0.0 in its own metadata, but 1.74.0.0 is what's on disk) - .NET
         Framework's strict strong-name binding throws FileLoadException without a redirect bridging
         that gap. NUnit3TestAdapter picks up this generated <AssemblyName>.dll.config automatically. -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- see ECInterfaces 2010.csproj: AppendTargetFrameworkToOutputPath=false also unsuffixes obj\,
         which collides across TFMs building in parallel - obj\ has no external consumers, so just
         suffix it unconditionally. -->
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\$(TargetFramework)\</IntermediateOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)'=='net9.0-windows'">
    <UseWindowsForms>true</UseWindowsForms>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <!-- every TFM gets its own sibling folder under output\ (including net48, via $(TargetFramework))
       - see ECInterfaces 2010.csproj for why -->
  <PropertyGroup Condition="'$(Platform)'=='x86'">
    <OutputPath>$(SolutionDir)output\$(TargetFramework)\Win32\$(Configuration)\</OutputPath>
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='x64'">
    <OutputPath>$(SolutionDir)output\$(TargetFramework)\$(Platform)\$(Configuration)\</OutputPath>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DefineConstants>DEBUG</DefineConstants>
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)'=='net462' or '$(TargetFramework)'=='net48'">
    <Reference Include="System" />
    <Reference Include="System.ComponentModel.DataAnnotations" />
    <Reference Include="System.Data" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Numerics" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="TestEcTranslators.cs" Condition="'$(OS)'!='Windows_NT'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ECInterfaces\ECInterfaces 2010.csproj" />
    <ProjectReference Include="..\EcTranslators\EcTranslators.csproj" Condition="('$(OS)'=='Windows_NT')" />
    <ProjectReference Include="..\EncCnvtrs\EncCnvtrs 2010.csproj" />
    <!-- for EncConverterHostRequest only (TestEncConverterHost.cs) - deliberately just this DTO type,
         not the transducer assemblies themselves (AIGuesserEC, CcEC, etc.): those get loaded by the
         EncConverterHostExe.exe *subprocess* via reflection off their own simple names, exactly like
         production use - see Handover.md, "Generic subprocess fallback for host-process conflicts". -->
    <ProjectReference Include="..\EncConverterHostExe\EncConverterHostExe.csproj" />
    <ProjectReference Include="..\IcuEC\IcuEC 2010.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\PerlExpressionEC\PerlExpressionEC 2010.csproj" />
    <ProjectReference Include="..\PyScriptEC\PyScriptEC 2010.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" Version="3.13.3" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <!-- Only net9.0-windows needs this: NUnit3TestAdapter alone doesn't provide a testhost for
         .NET Core/.NET 5+ TFMs (dotnet test/vstest need Microsoft.NET.Test.Sdk for that, regardless
         of NUnit version - net462/net48 don't need it and are left untouched by this condition). -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" Condition="'$(TargetFramework)'=='net9.0-windows'" />
  </ItemGroup>

  <ItemGroup>
    <None Include="app.config" />
  </ItemGroup>

  <!-- Restored from the original: this test host can end up dynamically loading an EcTranslators-
       provided converter by ProgID at runtime, not just via a compile-time reference, so it needs the
       same package set in its own output folder - see EcTranslators.csproj for the full rationale.
       The SolutionDir fallback above makes the Import resolve correctly for standalone builds too. -->
  <Import Project="$(SolutionDir)SharedItems.props" />
</Project>
