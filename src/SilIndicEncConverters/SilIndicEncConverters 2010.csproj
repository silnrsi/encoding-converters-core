<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <!-- $(SolutionDir) is only meaningfully set by MSBuild when building via the .sln (see ECInterfaces
       2010.csproj for the full rationale) -->
  <PropertyGroup Condition="'$(SolutionDir)'=='' or '$(SolutionDir)'=='*Undefined*' or '$(SolutionDir)'=='$(MSBuildProjectDirectory)\'">
    <SolutionDir>$(MSBuildThisFileDirectory)..\..\</SolutionDir>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFrameworks>net462;net48;net9.0-windows</TargetFrameworks>
    <!-- required for VS's Configuration Manager to accept the .sln's x86/x64 entries for this
         multi-targeted project - see ECInterfaces 2010.csproj for why -->
    <Platforms>x86;x64</Platforms>
    <ProjectGuid>{DC0A7A02-87B7-4619-B45F-D5A3ECB599A9}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>SilEncConverters40</RootNamespace>
    <AssemblyName>SilIndicEncConverters40</AssemblyName>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\FieldWorks.snk</AssemblyOriginatorKeyFile>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BaseAddress>285212672</BaseAddress>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- see ECInterfaces 2010.csproj: AppendTargetFrameworkToOutputPath=false also unsuffixes obj\,
         which collides across TFMs building in parallel - obj\ has no external consumers, so just
         suffix it unconditionally. -->
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\$(TargetFramework)\</IntermediateOutputPath>
    <!-- this folder also contains Font2IsciiEncConverter.cs/ITransEncConverter.cs/UTransEncConverter.cs,
         which the original explicit-only item list never included (excluded/dormant code); disable
         default globbing so they (and anything else not explicitly listed below) stay excluded exactly
         as before -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
  </PropertyGroup>

  <!-- Replaces RegisterForComInterop, which failed the ENTIRE build without admin rights (see
       ECInterfaces 2010.csproj for the full rationale - no downstream merge module actually needs
       SilIndicEncConverters40.tlb, but the admin-only failure mode still broke ordinary non-elevated
       builds of the whole solution, which is the actual problem being fixed here). -->
  <Target Name="ExportAndRegisterTypeLibrary" AfterTargets="Build" Condition="'$(TargetFramework)'=='net462' or '$(TargetFramework)'=='net48'">
    <PropertyGroup>
      <!-- $(TargetFrameworkSDKToolsDirectory) is only populated by the full MSBuild toolset (VS/MSBuild.exe);
           `dotnet build` never sets it, which made TlbExp resolve to an empty path and fail with MSB3073.
           Fall back to the well-known Windows SDK NETFX Tools folder so this works under both hosts. -->
      <_NetFxToolsDir Condition="'$(TargetFrameworkSDKToolsDirectory)' != ''">$(TargetFrameworkSDKToolsDirectory)</_NetFxToolsDir>
      <_NetFxToolsDir Condition="'$(TargetFrameworkSDKToolsDirectory)' == ''">$(MSBuildProgramFiles32)\Microsoft SDKs\Windows\v10.0A\bin\NETFX 4.8 Tools\</_NetFxToolsDir>
      <_TlbExpToolPath Condition="'$(Platform)'=='x64'">$(_NetFxToolsDir)x64\TlbExp.exe</_TlbExpToolPath>
      <_TlbExpToolPath Condition="'$(Platform)'!='x64'">$(_NetFxToolsDir)TlbExp.exe</_TlbExpToolPath>
      <_RegAsmToolPath Condition="'$(Platform)'=='x64'">$(SystemRoot)\Microsoft.NET\Framework64\v4.0.30319\RegAsm.exe</_RegAsmToolPath>
      <_RegAsmToolPath Condition="'$(Platform)'!='x64'">$(SystemRoot)\Microsoft.NET\Framework\v4.0.30319\RegAsm.exe</_RegAsmToolPath>
    </PropertyGroup>
    <Exec Command="&quot;$(_TlbExpToolPath)&quot; &quot;$(TargetPath)&quot; /out:&quot;$(TargetDir)$(TargetName).tlb&quot;" />
    <Exec Command="&quot;$(_RegAsmToolPath)&quot; &quot;$(TargetPath)&quot; /codebase /tlb:&quot;$(TargetDir)$(TargetName).tlb&quot;"
          ContinueOnError="WarnAndContinue"
          Condition="'$(Configuration)'=='Debug'" />
  </Target>

  <PropertyGroup Condition="'$(TargetFramework)'=='net9.0-windows'">
    <UseWindowsForms>true</UseWindowsForms>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <!-- every TFM gets its own sibling folder under output\ (including net48, via $(TargetFramework))
       - see ECInterfaces 2010.csproj for why -->
  <PropertyGroup Condition="'$(Platform)'=='x86'">
    <OutputPath>$(SolutionDir)output\$(TargetFramework)\Win32\$(Configuration)\</OutputPath>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='x64'">
    <OutputPath>$(SolutionDir)output\$(TargetFramework)\$(Platform)\$(Configuration)\</OutputPath>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)'=='net462' or '$(TargetFramework)'=='net48'">
    <Reference Include="System" />
    <Reference Include="System.Configuration.Install" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Management" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Xml" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="ElementPicker.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="ElementPicker.Designer.cs">
      <DependentUpon>ElementPicker.cs</DependentUpon>
    </Compile>
    <Compile Include="TechHindiSiteAutoConfigDialog.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="TechHindiSiteAutoConfigDialog.Designer.cs">
      <DependentUpon>TechHindiSiteAutoConfigDialog.cs</DependentUpon>
    </Compile>
    <Compile Include="TechHindiSiteConfig.cs" />
    <Compile Include="TechHindiSiteEncConverter.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\FieldWorks.snk">
      <Link>FieldWorks.snk</Link>
    </None>
    <None Include="app.config" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\redist\EC\Plugins\SIEC 4.0.0.0 Plugin Details.xml">
      <Link>SIEC 4.0.0.0 Plugin Details.xml</Link>
    </Content>
    <Content Include="TRFFC17.ICO" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="ElementPicker.resx">
      <DependentUpon>ElementPicker.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="TechHindiSiteAutoConfigDialog.resx">
      <DependentUpon>TechHindiSiteAutoConfigDialog.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ECInterfaces\ECInterfaces 2010.csproj" />
    <ProjectReference Include="..\EncCnvtrs\EncCnvtrs 2010.csproj" />
  </ItemGroup>
</Project>
