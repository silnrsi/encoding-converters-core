  <!-- $(SolutionDir) is only meaningfully set by MSBuild when building via the .sln (see ECInterfaces
       2010.csproj for the full rationale) -->
  <PropertyGroup Condition="'$(SolutionDir)'=='' or '$(SolutionDir)'=='*Undefined*' or '$(SolutionDir)'=='$(MSBuildProjectDirectory)\'">
    <SolutionDir>$(MSBuildThisFileDirectory)..\..\</SolutionDir>
  </PropertyGroup>

  <PropertyGroup>
    <!-- net9.0-windows is NOT achievable here without real source changes: CscProject.cs uses
         System.Runtime.Serialization.Formatters.Soap (removed entirely from modern .NET, no
         replacement package) and LoginSF.Designer.cs uses the legacy MenuItem/ContextMenu WinForms
         API (dropped when WinForms was ported to .NET Core - only ContextMenuStrip/ToolStripMenuItem
         ship there). Both are genuine porting work, out of scope for a project-file-only pass - see
         Handover.md. net462/net48 are unaffected and keep working exactly as before. -->
    <TargetFrameworks>net462;net48</TargetFrameworks>
    <!-- required for VS's Configuration Manager to accept the .sln's x86/x64 entries for this
         multi-targeted project - see ECInterfaces 2010.csproj for why -->
    <Platforms>x86;x64</Platforms>
    <ProjectGuid>{1F6E3722-B445-4638-90D6-22DDE860DCC6}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>SpellingFixer30</RootNamespace>
    <AssemblyName>SpellingFixer30</AssemblyName>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>FieldWorks.snk</AssemblyOriginatorKeyFile>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <BaseAddress>285212672</BaseAddress>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- see ECInterfaces 2010.csproj: AppendTargetFrameworkToOutputPath=false also unsuffixes obj\,
         which collides across TFMs building in parallel - obj\ has no external consumers, so just
         suffix it unconditionally. -->
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\$(TargetFramework)\</IntermediateOutputPath>
    <!-- this folder also contains KnownGoodWordList.cs/LoginSFCsC.cs/.resx, which the original
         explicit-only item list never included (excluded/dormant code); disable default globbing so
         they (and anything else not explicitly listed below) stay excluded exactly as before -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
  </PropertyGroup>

  <!-- every TFM gets its own sibling folder under output\ (including net48, via $(TargetFramework))
       - see ECInterfaces 2010.csproj for why -->
  <PropertyGroup Condition="'$(Platform)'=='x86'">
    <OutputPath>$(SolutionDir)output\$(TargetFramework)\Win32\$(Configuration)\</OutputPath>
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='x64'">
    <OutputPath>$(SolutionDir)output\$(TargetFramework)\$(Platform)\$(Configuration)\</OutputPath>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

