<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net462 and net9.0-windows are NOT achievable here without real source changes:
         BackTranslationHelperCtrl.cs uses ValueTuple/tuple syntax and Enumerable.ToHashSet(), both
         of which need .NET Framework 4.7.1+ (net462's mscorlib predates them, and there's no clean
         compat package for ToHashSet); BackTranslationHelperCtrl.designer.cs uses the legacy
         ContextMenu WinForms API, dropped when WinForms was ported to .NET Core. Both are genuine
         porting work, out of scope for a project-file-only pass - see Handover.md. net48 is
         unaffected and keeps working exactly as before. -->
    <TargetFrameworks>net48</TargetFrameworks>
    <!-- required for VS's Configuration Manager to accept the .sln's x86/x64 entries for this
         project - see ECInterfaces 2010.csproj for why -->
    <Platforms>x86;x64</Platforms>
    <ProjectGuid>{3E74CE98-6558-4AF0-BB0C-C7E436208B1B}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>BackTranslationHelper</RootNamespace>
    <AssemblyName>BackTranslationHelper</AssemblyName>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\FieldWorks.snk</AssemblyOriginatorKeyFile>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>8.0</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- see ECInterfaces 2010.csproj: AppendTargetFrameworkToOutputPath=false also unsuffixes obj\,
         which collides across TFMs building in parallel - obj\ has no external consumers, so just
         suffix it unconditionally. -->
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\$(TargetFramework)\</IntermediateOutputPath>
    <!-- this folder also contains BackTranslationHelperView.*/BackTranslationHelperViewHtml.cs, which
         the original explicit-only item list never included (excluded/dormant code); disable default
         globbing so they (and anything else not explicitly listed below) stay excluded exactly as before -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
  </PropertyGroup>

  <!-- these paths are relative to the project directory (..\..\ = repo root), so they work regardless
       of whether $(SolutionDir) is set - no fallback needed here, unlike most other converted projects -->
  <!-- every TFM gets its own sibling folder under output\ (including net48, via $(TargetFramework))
       - see ECInterfaces 2010.csproj for why -->
  <PropertyGroup Condition="'$(Platform)'=='x86'">
    <OutputPath>..\..\output\$(TargetFramework)\Win32\$(Configuration)\</OutputPath>
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='x64'">
    <OutputPath>..\..\output\$(TargetFramework)\$(Platform)\$(Configuration)\</OutputPath>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)'=='net462' or '$(TargetFramework)'=='net48'">
    <Reference Include="System" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Management" />
    <Reference Include="System.Net" />
    <Reference Include="System.Numerics" />
    <Reference Include="System.ServiceModel" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Transactions" />
    <Reference Include="System.Web" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Data" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Xml" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="BackTranslationHelperCtrl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Include="BackTranslationHelperCtrl.designer.cs">
      <DependentUpon>BackTranslationHelperCtrl.cs</DependentUpon>
    </Compile>
    <Compile Include="BackTranslationHelperModel.cs" />
    <Compile Include="ExampleEditorDialog.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="ExampleEditorDialog.Designer.cs">
      <DependentUpon>ExampleEditorDialog.cs</DependentUpon>
    </Compile>
    <Compile Include="FindReplaceHelper.cs" />
    <Compile Include="IBackTranslationHelperDataSource.cs" />
    <Compile Include="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Include="TranslatorListForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="TranslatorListForm.Designer.cs">
      <DependentUpon>TranslatorListForm.cs</DependentUpon>
    </Compile>
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Properties\Settings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="ExampleEditorDialog.resx">
      <DependentUpon>ExampleEditorDialog.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="TranslatorListForm.resx">
      <DependentUpon>TranslatorListForm.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="BackTranslationHelperCtrl.resx">
      <DependentUpon>BackTranslationHelperCtrl.cs</DependentUpon>
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <EmbeddedResource Include="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <SubType>Designer</SubType>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\FieldWorks.snk">
      <Link>FieldWorks.snk</Link>
    </None>
    <None Include="app.config" />
    <None Include="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\FillDownHS.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Content Include="html\BackTranslationHelperHtmlPage.html" />
    <Content Include="html\BackTranslationHelperJavaScriptFunctions.js" />
    <Content Include="html\jquery-3.6.0.min.js" />
    <None Include="Resources\Play.bmp" />
    <None Include="Resources\Pause.bmp" />
    <None Include="Resources\FillUpHS.png" />
    <None Include="Resources\pinup.bmp" />
    <None Include="Resources\pindown.bmp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ECInterfaces\ECInterfaces 2010.csproj" />
    <ProjectReference Include="..\EncCnvtrs\EncCnvtrs 2010.csproj" />
    <ProjectReference Include="..\SpellingFixer30\SpellingFixer30.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json">
      <Version>13.0.4</Version>
    </PackageReference>
  </ItemGroup>
</Project>
