<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <!-- $(SolutionDir) is only meaningfully set by MSBuild when building via the .sln (see ECInterfaces
       2010.csproj for the full rationale) -->
  <PropertyGroup Condition="'$(SolutionDir)'=='' or '$(SolutionDir)'=='*Undefined*' or '$(SolutionDir)'=='$(MSBuildProjectDirectory)\'">
    <SolutionDir>$(MSBuildThisFileDirectory)..\..\</SolutionDir>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFrameworks>net462;net48;net9.0-windows</TargetFrameworks>
    <!-- required for VS's Configuration Manager to accept the .sln's x86/x64 entries for this
         multi-targeted project - see ECInterfaces 2010.csproj for why -->
    <Platforms>x86;x64</Platforms>
    <ProjectGuid>{D1BAE593-A552-4F1A-8B08-5A1C27875C2F}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>IcuEC</RootNamespace>
    <AssemblyName>IcuEC</AssemblyName>
    <!-- restores this project's pre-SDK-conversion signing (matches ECInterfaces/EncCnvtrs/AIGuesserEC/
         CcEC/SilIndicEncConverters, all signed with the same key): a .NET Framework assembly that is
         itself strongly named (TestEncCnvtrs, signed this session for InternalsVisibleTo) cannot
         reference a weakly-named one - doing so throws FileLoadException ("A strongly-named assembly is
         required") at load time under net462/net48 (confirmed - this was reported after that change). -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\FieldWorks.snk</AssemblyOriginatorKeyFile>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- see ECInterfaces 2010.csproj: AppendTargetFrameworkToOutputPath=false also unsuffixes obj\,
         which collides across TFMs building in parallel - obj\ has no external consumers, so just
         suffix it unconditionally. -->
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\$(TargetFramework)\</IntermediateOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)'=='net9.0-windows'">
    <UseWindowsForms>true</UseWindowsForms>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <!-- every TFM gets its own sibling folder under output\ (including net48, via $(TargetFramework))
       - see ECInterfaces 2010.csproj for why -->
  <PropertyGroup Condition="'$(Platform)'=='x86'">
    <OutputPath>$(SolutionDir)output\$(TargetFramework)\Win32\$(Configuration)\</OutputPath>
    <!-- must be x86, not AnyCPU: this codebase's native transducer DLLs (e.g. TECkit_x86.dll,
         CC32.dll) only load if the process itself is forced 32-bit - see CLAUDE.md's "Strict
         Bit-Width Separation" constraint - AnyCPU here let the process run as 64-bit on a 64-bit
         OS, breaking every x86 native-interop test. -->
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='x64'">
    <OutputPath>$(SolutionDir)output\$(TargetFramework)\$(Platform)\$(Configuration)\</OutputPath>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)'=='net462' or '$(TargetFramework)'=='net48'">
    <Reference Include="System" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <ItemGroup Condition="'$(OS)'=='Windows_NT'">
    <Compile Include="IcuBreakIteratorEncConverter.cs" />
    <Compile Include="IcuBreakIteratorAutoConfigDialog.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="IcuBreakIteratorConfig.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="IcuConvAutoConfigDialog.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="IcuConvConfig.cs" />
    <Compile Include="IcuConvEncConverter.cs" />
    <Compile Include="IcuRegexAutoConfigDialog.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="IcuRegexConfig.cs" />
    <Compile Include="IcuRegexEncConverter.cs" />
    <Compile Include="IcuTranslitAutoConfigDialog.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="IcuTranslitConfig.cs" />
    <Compile Include="IcuTranslitEncConverter.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Properties\Settings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
    <Compile Include="Resources.Designer.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ECInterfaces\ECInterfaces 2010.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\EncCnvtrs\EncCnvtrs 2010.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Replaces the ProjectReference to the old ICU4NET.vcxproj (C++/CLI mixed-mode wrapper around
         the same native ICU BreakIterator API) - mixed-mode assemblies can never be loaded by .NET
         Core/.NET 5+, so that project structurally could not support net9.0-windows. icu.net is SIL's
         own pure P/Invoke wrapper over the identical native ubrk_* API, so it resolves for all TFMs
         here and produces byte-identical segmentation output (same native icuucNN/icuinNN/icudtNN.dll
         already redistributed via the PostBuildEvent below - only the .NET-side glue changed). -->
    <PackageReference Include="icu.net" Version="3.0.2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="IcuBreakIteratorAutoConfigDialog.resx">
      <DependentUpon>IcuBreakIteratorAutoConfigDialog.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="IcuConvAutoConfigDialog.resx">
      <DependentUpon>IcuConvAutoConfigDialog.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="IcuRegexAutoConfigDialog.resx">
      <DependentUpon>IcuRegexAutoConfigDialog.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="IcuTranslitAutoConfigDialog.resx">
      <DependentUpon>IcuTranslitAutoConfigDialog.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources.resx" />
  </ItemGroup>

  <ItemGroup>
    <None Include="app.config" />
    <None Include="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <!-- Native ICU redistributable DLLs, needed by icu.net's (and this project's own native
       IcuConvEC/IcuRegexEC/IcuTranslitEC's) P/Invoke calls at runtime. Declared as CopyToOutputDirectory
       items (not a PostBuildEvent Exec/copy command) so every TFM's own build gets a copy, and so any
       tooling that inspects the project's declared outputs rather than doing a raw filesystem scan
       (test-runner shadow-copy, CI artifact steps, etc.) sees them too - a raw copy command is
       invisible to that kind of tooling. -->
  <ItemGroup Condition="'$(Platform)'=='x64'">
    <None Include="$(SolutionDir)DistFiles\windows\x64\icu\bin\icuuc68.dll">
      <Link>icuuc68.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(SolutionDir)DistFiles\windows\x64\icu\bin\icuin68.dll">
      <Link>icuin68.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(SolutionDir)DistFiles\windows\x64\icu\bin\icudt68.dll">
      <Link>icudt68.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup Condition="'$(Platform)'!='x64'">
    <None Include="$(SolutionDir)DistFiles\windows\Win32\icu\bin\icuuc68.dll">
      <Link>icuuc68.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(SolutionDir)DistFiles\windows\Win32\icu\bin\icuin68.dll">
      <Link>icuin68.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(SolutionDir)DistFiles\windows\Win32\icu\bin\icudt68.dll">
      <Link>icudt68.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- IcuConvEC/IcuRegexEC/IcuTranslitEC (see IcuConvEncConverter.cs/IcuRegexEncConverter.cs/
       IcuTranslitEncConverter.cs's [DllImport] calls) are native C++ projects that can only ever
       target net48 - vcxproj has no multi-targeting mechanism, and they're wired as solution-level
       ProjectDependencies of this project (see EncConverters 2019.sln), so their net48 build is
       always complete before any of this project's own TFM builds run. Every OTHER TFM still needs a
       copy of that net48-built output alongside its own $(TargetDir) for P/Invoke resolution at
       runtime - net48 itself already has them (the native projects build directly into this same
       folder), so this only applies to the other TFMs. -->
  <!-- The native vcxproj projects use $(Platform)=='Win32' for their own x86 build (the classic VC++
       convention), NOT 'x86' - $(Platform) as seen by THIS (C#) project's x86 build resolves to 'x86'
       instead (see the OutputPath PropertyGroups above), so the source folder name has to be
       hardcoded to 'Win32' for that case rather than reusing $(Platform) directly (confirmed via
       MSB3030 "could not copy... not found" when this used $(Platform) unconditionally). -->
  <ItemGroup Condition="'$(TargetFramework)'!='net48' and '$(Platform)'=='x86'">
    <None Include="$(SolutionDir)output\net48\Win32\$(Configuration)\IcuConvEC.dll">
      <Link>IcuConvEC.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(SolutionDir)output\net48\Win32\$(Configuration)\IcuRegexEC.dll">
      <Link>IcuRegexEC.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(SolutionDir)output\net48\Win32\$(Configuration)\IcuTranslitEC.dll">
      <Link>IcuTranslitEC.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)'!='net48' and '$(Platform)'=='x64'">
    <None Include="$(SolutionDir)output\net48\$(Platform)\$(Configuration)\IcuConvEC.dll">
      <Link>IcuConvEC.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(SolutionDir)output\net48\$(Platform)\$(Configuration)\IcuRegexEC.dll">
      <Link>IcuRegexEC.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(SolutionDir)output\net48\$(Platform)\$(Configuration)\IcuTranslitEC.dll">
      <Link>IcuTranslitEC.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
