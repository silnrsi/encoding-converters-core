<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <!-- $(SolutionDir) is only meaningfully set by MSBuild when building via the .sln (see ECInterfaces
       2010.csproj for the full rationale) -->
  <PropertyGroup Condition="'$(SolutionDir)'=='' or '$(SolutionDir)'=='*Undefined*' or '$(SolutionDir)'=='$(MSBuildProjectDirectory)\'">
    <SolutionDir>$(MSBuildThisFileDirectory)..\..\</SolutionDir>
  </PropertyGroup>

  <PropertyGroup>
    <!-- net9.0-windows, not bare net9.0: EncCnvtrs only targets net9.0-windows - see RunTests
         2010.csproj for why matching the TFM suffix matters. -->
    <TargetFrameworks>net462;net48;net9.0-windows</TargetFrameworks>
    <!-- required for VS's Configuration Manager to accept the .sln's x86/x64 entries for this
         multi-targeted project - see ECInterfaces 2010.csproj for why -->
    <Platforms>x86;x64</Platforms>
    <ProjectGuid>{1E45DBF2-3629-4413-AC1F-61E6AA33B9B6}</ProjectGuid>
    <ApplicationIcon>App.ico</ApplicationIcon>
    <OutputType>Exe</OutputType>
    <RootNamespace>ECFileConverter</RootNamespace>
    <AssemblyName>ECFileConverter</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- AssemblyInfo.cs uses a wildcard AssemblyVersion ("1.0.*"), which only compiles with
         determinism off (old-style projects defaulted to non-deterministic builds; SDK-style
         defaults to deterministic=true) -->
    <Deterministic>false</Deterministic>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- see ECInterfaces 2010.csproj: AppendTargetFrameworkToOutputPath=false also unsuffixes obj\,
         which collides across TFMs building in parallel - obj\ has no external consumers, so just
         suffix it unconditionally. -->
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\$(TargetFramework)\</IntermediateOutputPath>
  </PropertyGroup>

  <!-- every TFM gets its own sibling folder under output\ (including net48, via $(TargetFramework))
       - see ECInterfaces 2010.csproj for why -->
  <PropertyGroup Condition="'$(Platform)'=='x86'">
    <OutputPath>$(SolutionDir)output\$(TargetFramework)\Win32\$(Configuration)\</OutputPath>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='x64'">
    <OutputPath>$(SolutionDir)output\$(TargetFramework)\$(Platform)\$(Configuration)\</OutputPath>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)'=='net462' or '$(TargetFramework)'=='net48'">
    <Reference Include="System" />
    <Reference Include="System.ComponentModel.DataAnnotations" />
    <Reference Include="System.Data" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Numerics" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="App.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="app.config" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ECInterfaces\ECInterfaces 2010.csproj" />
    <ProjectReference Include="..\EncCnvtrs\EncCnvtrs 2010.csproj" />
  </ItemGroup>

  <!-- Restored from the original: this host EXE can end up dynamically loading an EcTranslators-
       provided converter by ProgID at runtime (see EncConverters.InstantiateIEncConverter), not just
       via a compile-time reference, so it needs the same package set in its own output folder - see
       EcTranslators.csproj for the full rationale. The SolutionDir fallback above makes the Import
       resolve correctly for standalone (non-.sln-context) builds too. -->
  <Import Project="$(SolutionDir)SharedItems.props" />
</Project>
