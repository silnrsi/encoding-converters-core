<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <!-- $(SolutionDir) is only meaningfully set by MSBuild when building via the .sln (see ECInterfaces
       2010.csproj for the full rationale); needed here for the SharedItems.props import below. -->
  <PropertyGroup Condition="'$(SolutionDir)'=='' or '$(SolutionDir)'=='*Undefined*' or '$(SolutionDir)'=='$(MSBuildProjectDirectory)\'">
    <SolutionDir>$(MSBuildThisFileDirectory)..\..\</SolutionDir>
  </PropertyGroup>

  <PropertyGroup>
    <!-- net9.0-windows, not bare net9.0: TestEncCnvtrs (and its own dependencies IcuEC/PerlExpressionEC/
         PyScriptEC/EcTranslators) only target net9.0-windows. A bare net9.0 consumer can still
         "resolve" against a .NET Framework-targeted ProjectReference via NuGet's compat-shim fallback,
         but that's silent (NU1702 warning only) and fragile at runtime - matching the TFM suffix avoids
         the fallback and gets the real net9.0-windows build of each dependency instead. -->
    <TargetFrameworks>net462;net48;net9.0-windows</TargetFrameworks>
    <!-- required for VS's Configuration Manager to accept the .sln's x86/x64 entries for this
         multi-targeted project - see ECInterfaces 2010.csproj for why -->
    <Platforms>x86;x64</Platforms>
    <ProjectGuid>{05A68C57-DC5D-4B49-AB0F-0AEC64A49716}</ProjectGuid>
    <OutputType>Exe</OutputType>
    <RootNamespace>RunTests</RootNamespace>
    <AssemblyName>RunTests</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- AssemblyInfo.cs uses a wildcard AssemblyVersion ("1.0.*"), which only compiles with
         determinism off (old-style projects defaulted to non-deterministic builds; SDK-style
         defaults to deterministic=true) -->
    <Deterministic>false</Deterministic>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- see ECInterfaces 2010.csproj: AppendTargetFrameworkToOutputPath=false also unsuffixes obj\,
         which collides across TFMs building in parallel - obj\ has no external consumers, so just
         suffix it unconditionally. -->
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\$(TargetFramework)\</IntermediateOutputPath>
  </PropertyGroup>

  <!-- every TFM gets its own sibling folder under bin\ (including net48, via $(TargetFramework))
       - see ECInterfaces 2010.csproj for why -->
  <PropertyGroup>
    <OutputPath>bin\$(TargetFramework)\$(Platform)\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DefineConstants>DEBUG</DefineConstants>
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)'=='x64'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='x86' and '$(Configuration)'=='Debug'">
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='x86' and '$(Configuration)'=='Release'">
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)'=='net462' or '$(TargetFramework)'=='net48'">
    <Reference Include="System" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TestEncCnvtrs\TestEncCnvtrs 2010.csproj" />
  </ItemGroup>

  <!-- Restored from the original: this test runner can end up dynamically loading an EcTranslators-
       provided converter by ProgID at runtime, not just via a compile-time reference, so it needs the
       same package set in its own output folder - see EcTranslators.csproj for the full rationale. -->
  <Import Project="$(SolutionDir)SharedItems.props" />
</Project>
