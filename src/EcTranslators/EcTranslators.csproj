  <!-- AzureOpenAiExe.exe/VertexAiExe.exe are launched as separate OS processes via Process.Start (see
       AzureOpenAiEncConverter.cs/VertexAiEncConverter.cs's ExePath), which requires the exe to sit in
       the SAME folder as this project's own output (Assembly.GetExecutingAssembly().Location). For
       net462/net48 this already works "by accident": AzureOpenAiExe/VertexAiExe also target those
       exact TFM strings, so they land in the identical output\<tfm>\... folder as this project. But
       they're plain console tools with no WinForms dependency, so they only have a bare net9.0 build,
       not net9.0-windows - net9.0-windows needs an explicit copy. A subprocess exe doesn't need to
       match the caller's own TFM/runtime at all (Process.Start launches a fully separate, self-hosted
       .NET process), so the closest available modern build works fine here. -->
  <!-- AzureOpenAiExe/VertexAiExe hardcode "Win32" (not "x86") as their own x86-Platform folder name,
       same as this project does (see the OutputPath PropertyGroups above) - $(Platform) itself is
       "x86" here, so it can't be reused directly for the x86 case (confirmed via MSB3030 "could not
       copy... not found" when this used $(Platform) unconditionally - see IcuEC 2010.csproj for the
       same mistake made and fixed there first). -->
  <ItemGroup Condition="'$(TargetFramework)'=='net9.0-windows' and '$(Platform)'=='x86'">
    <_AzureOpenAiVertexAiExeFiles Include="$(SolutionDir)output\net9.0\Win32\$(Configuration)\AzureOpenAiExe.*" />
    <_AzureOpenAiVertexAiExeFiles Include="$(SolutionDir)output\net9.0\Win32\$(Configuration)\VertexAiExe.*" />
    <None Include="@(_AzureOpenAiVertexAiExeFiles)">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)'=='net9.0-windows' and '$(Platform)'=='x64'">
    <_AzureOpenAiVertexAiExeFiles Include="$(SolutionDir)output\net9.0\$(Platform)\$(Configuration)\AzureOpenAiExe.*" />
    <_AzureOpenAiVertexAiExeFiles Include="$(SolutionDir)output\net9.0\$(Platform)\$(Configuration)\VertexAiExe.*" />
    <None Include="@(_AzureOpenAiVertexAiExeFiles)">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

