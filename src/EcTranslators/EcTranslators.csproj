  <!-- Kept as the single shared source of truth for this package list (not flattened into direct
       PackageReferences): host EXE clients - both in this solution and, more importantly, the
       dozens in the separate SilConverters solution - resolve EcTranslators-provided converters
       dynamically by ProgID at runtime (see EncConverters.InstantiateIEncConverter), not only via a
       compile-time reference to this project, so they need this same package set sitting in their own
       output folder regardless of whether they reference EcTranslators.csproj directly. Duplicating
       this list per host project would defeat the point. The only real issue with the Import was that
       $(SolutionDir) isn't set for a standalone (non-.sln-context) restore of this project alone -
       the fallback above fixes that without giving up the shared file. -->
  <Import Project="$(SolutionDir)SharedItems.props" />
