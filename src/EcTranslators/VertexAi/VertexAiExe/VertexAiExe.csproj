<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net462;net48;net9.0</TargetFrameworks>
    <!-- required for VS's Configuration Manager to accept the .sln's x86/x64 entries for this
         multi-targeted project - see ECInterfaces 2010.csproj for why -->
    <Platforms>x86;x64</Platforms>
    <ProjectGuid>{5E1021B4-61AE-4E96-8D5A-7CDF6D5F7982}</ProjectGuid>
    <OutputType>Exe</OutputType>
    <RootNamespace>SilEncConverters40.EcTranslators.VertexAi.VertexAiExe</RootNamespace>
    <AssemblyName>VertexAiExe</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- see ECInterfaces 2010.csproj: AppendTargetFrameworkToOutputPath=false also unsuffixes obj\,
         which collides across TFMs building in parallel - obj\ has no external consumers, so just
         suffix it unconditionally. -->
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\$(TargetFramework)\</IntermediateOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!-- these paths are relative to the project directory (..\..\..\..\ = repo root), so they work
       regardless of whether $(SolutionDir) is set. Every TFM gets its own sibling folder under
       output\ (including net48, via $(TargetFramework)) - see ECInterfaces 2010.csproj for why. -->
  <PropertyGroup Condition="'$(Platform)'=='x86'">
    <OutputPath>..\..\..\..\output\$(TargetFramework)\Win32\$(Configuration)\</OutputPath>
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='x64'">
    <OutputPath>..\..\..\..\output\$(TargetFramework)\$(Platform)\$(Configuration)\</OutputPath>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup>
    <Prefer32Bit>true</Prefer32Bit>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)'=='net462' or '$(TargetFramework)'=='net48'">
    <Reference Include="System" />
    <Reference Include="System.Management" />
    <Reference Include="System.Numerics" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Data" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\PromptExeTranslatorCommandLineArgs.cs">
      <Link>PromptExeTranslatorCommandLineArgs.cs</Link>
    </Compile>
    <Compile Include="..\..\RsaEncryptionClass.cs">
      <Link>RsaEncryptionClass.cs</Link>
    </Compile>
    <Compile Include="..\VertexAiPromptExeTranslatorCommandLineArgs.cs">
      <Link>VertexAiPromptExeTranslatorCommandLineArgs.cs</Link>
    </Compile>
    <Compile Include="MessageClasses.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="App.config" />
  </ItemGroup>

