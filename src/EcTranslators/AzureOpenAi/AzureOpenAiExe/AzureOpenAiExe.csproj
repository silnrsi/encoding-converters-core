<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net462;net48;net9.0</TargetFrameworks>
    <!-- required for VS's Configuration Manager to accept the .sln's x86/x64 entries for this
         multi-targeted project - see ECInterfaces 2010.csproj for why -->
    <Platforms>x86;x64</Platforms>
    <ProjectGuid>{4F6FF8AD-6BEB-4104-B123-7FA9C2DC0BBE}</ProjectGuid>
    <OutputType>Exe</OutputType>
    <RootNamespace>SilEncConverters40.EcTranslators.AzureOpenAI.AzureOpenAiExe</RootNamespace>
    <AssemblyName>AzureOpenAiExe</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>8.0</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- see ECInterfaces 2010.csproj: AppendTargetFrameworkToOutputPath=false also unsuffixes obj\,
         which collides across TFMs building in parallel - obj\ has no external consumers, so just
         suffix it unconditionally. -->
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\$(TargetFramework)\</IntermediateOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!-- these paths are relative to the project directory (..\..\..\..\ = repo root), so they work
       regardless of whether $(SolutionDir) is set. Every TFM gets its own sibling folder under
       output\ (including net48, via $(TargetFramework)) - see ECInterfaces 2010.csproj for why. -->
  <PropertyGroup Condition="'$(Platform)'=='x86'">
    <OutputPath>..\..\..\..\output\$(TargetFramework)\Win32\$(Configuration)\</OutputPath>
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='x64'">
    <OutputPath>..\..\..\..\output\$(TargetFramework)\$(Platform)\$(Configuration)\</OutputPath>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup>
    <Prefer32Bit>true</Prefer32Bit>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)'=='net462' or '$(TargetFramework)'=='net48'">
    <Reference Include="System" />
    <Reference Include="System.Numerics" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Data" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\PromptExeTranslatorCommandLineArgs.cs">
      <Link>PromptExeTranslatorCommandLineArgs.cs</Link>
    </Compile>
    <Compile Include="..\..\RsaEncryptionClass.cs">
      <Link>RsaEncryptionClass.cs</Link>
    </Compile>
    <Compile Include="..\AzureOpenAiPromptExeTranslatorCommandLineArgs.cs">
      <Link>AzureOpenAiPromptExeTranslatorCommandLineArgs.cs</Link>
    </Compile>
    <Compile Include="Program.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="App.config" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces">
      <Version>10.0.10</Version>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions">
      <Version>10.0.10</Version>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions">
      <Version>10.0.10</Version>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json">
      <Version>13.0.4</Version>
    </PackageReference>
    <PackageReference Include="OpenAI">
      <Version>2.12.0</Version>
    </PackageReference>
    <PackageReference Include="System.Buffers">
      <Version>4.6.1</Version>
    </PackageReference>
    <PackageReference Include="System.ClientModel">
      <Version>1.15.0</Version>
    </PackageReference>
    <PackageReference Include="System.Diagnostics.DiagnosticSource">
      <Version>10.0.10</Version>
    </PackageReference>
    <PackageReference Include="System.IO.Pipelines">
      <Version>10.0.10</Version>
    </PackageReference>
    <PackageReference Include="System.Memory">
      <Version>4.6.3</Version>
    </PackageReference>
    <PackageReference Include="System.Memory.Data">
      <Version>10.0.10</Version>
    </PackageReference>
    <PackageReference Include="System.Numerics.Vectors">
      <Version>4.6.1</Version>
    </PackageReference>
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe">
      <Version>6.1.2</Version>
    </PackageReference>
    <PackageReference Include="System.Text.Encodings.Web">
      <Version>10.0.10</Version>
    </PackageReference>
    <PackageReference Include="System.Text.Json">
      <Version>10.0.10</Version>
    </PackageReference>
    <PackageReference Include="System.Threading.Tasks.Extensions">
      <Version>4.6.3</Version>
    </PackageReference>
    <PackageReference Include="System.ValueTuple">
      <Version>4.6.2</Version>
    </PackageReference>
  </ItemGroup>
</Project>
